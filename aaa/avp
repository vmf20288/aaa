// =====================================================================================
// avp.cs  (v1)
// -------------------------------------------------------------------------------------
// Qué hace:
//   - Construye un Volume-At-Price (VAP) usando Volumetric (Order Flow+) en una serie interna.
//   - Detecta HVN (picos) y LVN (valles) del perfil y dibuja líneas horizontales.
//
// Filosofía de esta versión:
//   - BARATA: Calcula en OnBarClose sobre la serie volumétrica interna (no OnEachTick).
//   - FIEL: Usa Bid+Ask por precio desde VolumetricBarsType (Order Flow+).
//   - PRÁCTICA: Puedes usar Rolling (X minutos), Session o Weekly.
//   - "Max VP price levels" estilo TradingView: opción AutoBinFromMaxLevels.
// =====================================================================================

namespace NinjaTrader.NinjaScript.Indicators
{
    // ---------------------------
    // Tipos
    // ---------------------------
    public enum ProfileMode
    {
        RollingMinutes = 0,
        Session        = 1,
        Weekly         = 2
    }

    public class avp : Indicator
    {

        private class BarContribution
        {
            public DateTime Time;
            public Dictionary<long, long> VolByTick = new Dictionary<long, long>(); // tickIndex -> volume
        }

        private class Node
        {
            public int    Index;        // índice en el array de bins
            public long   BinStartTick; // tickIndex del bin (inicio)
            public double Price;        // precio (centro del bin)
            public double Volume;       // volumen del bin (para ordenar)
        }

        // ---------------------------
        // Constantes
        // ---------------------------
        private const int MaxNodesLimit = 6;

        // ---------------------------
        // Campos internos
        // ---------------------------
        private int volBip = -1;
        private VolumetricBarsType volBarsType;
        private double tickSize = 0.0;

        // Perfil en resolución máxima (tick a tick)
        private readonly Dictionary<long, long> profileVolByTick = new Dictionary<long, long>();

        // Para Rolling: guardar contribución por barra para poder restar (ventana deslizante)
        private readonly Queue<BarContribution> rollingQueue = new Queue<BarContribution>();

        // Control de semana (futuros ETH, domingo 18:00)
        private DateTime currentWeekStart = DateTime.MinValue;

        // Últimos nodos detectados (para consumo externo e integración posterior)
        private double lastPOC = double.NaN;
        private readonly double[] lastHVN = new double[MaxNodesLimit];
        private readonly double[] lastLVN = new double[MaxNodesLimit];

        private string instanceTag = "";

